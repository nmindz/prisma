{
  "name": "@internal/extension-surrealdb",
  "private": true,
  "version": "8.0.0-rc.14",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "User-facing SurrealDB client for Prisma 8",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/adapter-surrealdb": "workspace:8.0.0-rc.14",
    "@internal/cli": "workspace:8.0.0-rc.14",
    "@internal/config": "workspace:8.0.0-rc.14",
    "@internal/contract": "workspace:8.0.0-rc.14",
    "@internal/driver-surrealdb": "workspace:8.0.0-rc.14",
    "@internal/family-surreal": "workspace:8.0.0-rc.14",
    "@internal/framework-components": "workspace:8.0.0-rc.14",
    "@internal/surreal-contract": "workspace:8.0.0-rc.14",
    "@internal/surreal-contract-ts": "workspace:8.0.0-rc.14",
    "@internal/surreal-errors": "workspace:8.0.0-rc.14",
    "@internal/surreal-lowering": "workspace:8.0.0-rc.14",
    "@internal/surreal-orm": "workspace:8.0.0-rc.14",
    "@internal/surreal-query-ast": "workspace:8.0.0-rc.14",
    "@internal/surreal-runtime": "workspace:8.0.0-rc.14",
    "@internal/surreal-value": "workspace:8.0.0-rc.14",
    "@internal/target-surrealdb": "workspace:8.0.0-rc.14",
    "@internal/utils": "workspace:8.0.0-rc.14"
  },
  "devDependencies": {
    "@internal/surreal-lowering": "workspace:8.0.0-rc.14",
    "@internal/surreal-schema-ir": "workspace:8.0.0-rc.14",
    "@repo/tsconfig": "workspace:8.0.0-rc.14",
    "@repo/tsdown": "workspace:8.0.0-rc.14",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./config": "./dist/config.mjs",
    "./contract-builder": "./dist/contract-builder.mjs",
    "./control": "./dist/control.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/orm.git",
    "directory": "packages/3-extensions/surrealdb"
  }
}
