{
  "name": "@internal/surreal-contract",
  "private": true,
  "version": "8.0.0-rc.14",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Contract storage IR for Prisma 8 SurrealDB support",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/contract": "workspace:8.0.0-rc.14",
    "@internal/framework-components": "workspace:8.0.0-rc.14",
    "@internal/surreal-value": "workspace:8.0.0-rc.14",
    "@internal/utils": "workspace:8.0.0-rc.14",
    "@standard-schema/spec": "1.1.0",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:8.0.0-rc.14",
    "@repo/tsdown": "workspace:8.0.0-rc.14",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./entity-kinds": "./dist/entity-kinds.mjs",
    "./types": "./dist/types.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/orm.git",
    "directory": "packages/2-surreal-family/1-foundation/surreal-contract"
  }
}
